        },
        "required_fields": ["input", "cache_read", "output"],
        "defaults": {
          "web_search": 0.01
        },
        "note": "Cursor's listed third-party rate. Plan-specific Cursor Token Rate, regional, and legacy Max uplifts are not applied because local artifacts do not identify the plan.",
        "rows": [
          { "match": "Claude Fable 5.1", "model": "claude-fable-5-1" },
          { "match": "Gemini 3.8 Flash", "model": "gemini-3.8-flash" },
