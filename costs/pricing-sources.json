          { "match": "GPT-5 Fast", "model": "gpt-5-fast", "note": "Cursor publishes GPT-5 Fast as a distinct 2x rate row." },
          { "match": "GPT-5.4", "model": "gpt-5.4" },
          { "match": "GPT-5.5", "model": "gpt-5.5" },
          { "match": "GPT-5.6 Luna", "model": "gpt-5.6-luna" },
          { "match": "GPT-5.6 Sol", "model": "gpt-5.6-sol", "effective_from": "2026-08-21" },
          { "match": "GPT-5.6 Terra", "model": "gpt-5.6-terra" },
          { "match": "Claude Sonnet 5", "model": "claude-sonnet-5" },
          { "match": "Claude Opus 5", "model": "claude-opus-5" },
          { "match": "Claude Opus 4.8", "model": "claude-opus-4-8" },
          { "match": "Gemini 3.6 Flash", "model": "gemini-3.6-flash" },
          { "match": "Gemini 3.7 Flash", "model": "gemini-3.7-flash" },
          { "match": "Kimi K2.7 Code", "model": "kimi-k2.7-code" },
          { "match": "Kimi K3", "model": "kimi-k3" }
        ]
      }
    },
    {
      "id": "cursor-gpt-5-4-fast-pricing",
      "name": "Cursor GPT-5.4 model pricing",
      "url": "https://cursor.com/docs/models/gpt-5-4",
      "kind": "html-table",
      "output": "overrides",
      "extract": {
        "mode": "model-rows",
        "scope": "tool",
        "tool": "cursor",
        "columns": { "model": "Name", "input": "Input", "cache_read": "Cache Read", "output": "Output" },
        "required_fields": ["input", "cache_read", "output"],
        "defaults": { "web_search": 0.01 },
        "rows": [
          {
            "match": "GPT-5.4",
            "model": "gpt-5.4-fast",
            "token_multipliers": { "input": 2, "cache_read": 2, "output": 2 },
            "note": "Cursor's GPT-5.4 model page publishes gpt-5.4-fast at 2x the standard token rates. The fixed web-search charge is not multiplied."
          },
          {
            "match": "GPT-5.4",
            "model": "gpt-5.4-long",
            "token_multipliers": { "input": 2, "cache_read": 2, "output": 1.5 },
            "note": "Cursor's GPT-5.4 model page publishes 2x input/cache-read and 1.5x output rates above 272K input tokens."
          },
          {
            "match": "GPT-5.4",
            "model": "gpt-5.4-fast-long",
            "token_multipliers": { "input": 4, "cache_read": 4, "output": 3 },
            "note": "Cursor's GPT-5.4 Fast long-context row combines the published 2x Fast tier with 2x input/cache-read and 1.5x output above 272K. The fixed web-search charge is not multiplied."
          }
        ]
      }
