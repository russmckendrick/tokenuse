          },
          {
            "match": "Grok 4.6 (Fast)",
            "model": "grok-4.6-fast",
            "note": "Cursor publishes Fast as a distinct first-party rate row."
          },
          {
            "match": "Grok 4.5",
            "model": "grok-4.5"
          },
          {
            "match": "Grok 4.5 (Fast)",
            "model": "grok-4.5-fast",
            "note": "Cursor publishes Fast as a distinct first-party rate row."
          }
        ]
      }
    },
    {
      "id": "cursor-retired-model-pricing",
      "name": "Cursor retired model pricing",
      "url": "https://cursor.com/docs/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "tool",
        "tool": "cursor",
        "defaults": {
          "web_search": 0.01
        },
