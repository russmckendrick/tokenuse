{
  "_metadata": {
    "schema": "tokenuse pricing-sources.v1",
    "description": "Config-driven pricing refresh sources. Rust owns generic fetch/extract/merge logic; URLs, filters, field mappings, and published book locations live here."
  },
  "published_books": {
    "upstream_url": "https://raw.githubusercontent.com/russmckendrick/tokenuse/refs/heads/main/costs/pricing-upstream.json",
    "overrides_url": "https://raw.githubusercontent.com/russmckendrick/tokenuse/refs/heads/main/costs/pricing-overrides.json"
  },
  "sources": [
    {
      "id": "litellm",
      "name": "LiteLLM model prices",
      "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
      "kind": "json-map",
      "output": "upstream",
      "include": {
        "key_contains": [
          "claude-opus-",
          "claude-sonnet-",
          "claude-haiku-",
          "claude-fable-",
          "claude-mythos-",
          "claude-3-",
          "gpt-5",
          "gpt-4o",
          "o1",
          "o3",
          "gemini-",
          "grok-"
        ],
        "canonical_exact": [
          "codex-mini-latest"
        ]
      },
      "fields": {
        "input": "input_cost_per_token",
        "output": "output_cost_per_token",
        "cache_write": "cache_creation_input_token_cost",
        "cache_read": "cache_read_input_token_cost"
      },
      "defaults": {
        "web_search": 0.01
      }
    },
    {
      "id": "anthropic-pricing",
      "name": "Claude pricing markdown",
      "url": "https://platform.claude.com/docs/en/about-claude/pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "table_heading": "Model pricing",
      "extract": {
        "mode": "model-rows",
        "scope": "global",
        "columns": {
          "model": "Model",
          "input": "Base Input Tokens",
          "cache_write": "5m Cache Writes",
          "cache_read": "Cache Hits & Refreshes",
          "output": "Output Tokens"
        },
        "defaults": {
          "web_search": 0.01
        },
        "rows": [
          { "match": "Claude Fable 5", "model": "claude-fable-5" },
          { "match": "Claude Mythos 5", "model": "claude-mythos-5" },
          {
            "match": "Claude Opus 5",
            "model": "claude-opus-5",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 5 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.8",
            "model": "claude-opus-4-8",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.8 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.8",
            "model": "claude-opus-4.8",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.8 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.7",
            "model": "claude-opus-4-7",
            "set": { "fast_multiplier": 6 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which listed Opus 4.7 fast mode at $30 input and $150 output per MTok; deprecated 2026-06-25 and removed 2026-07-24. Kept so archived fast-mode calls from before removal still price correctly."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4-6",
            "set": { "fast_multiplier": 6 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.6 fast mode at $30 input and $150 output per MTok."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4-6-20260205",
            "set": { "fast_multiplier": 6 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.6 fast mode at $30 input and $150 output per MTok."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4.6",
            "set": { "fast_multiplier": 6 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.6 fast mode at $30 input and $150 output per MTok."
          },
          {
            "match": "Claude Sonnet 5 starting September 1, 2026",
            "model": "claude-sonnet-5",
            "effective_from": "2026-09-01",
            "note": "Standard Sonnet 5 pricing takes effect 2026-09-01; introductory pricing through 2026-08-31 is carried by the upstream book."
          },
          { "match": "Claude Sonnet 4.6", "model": "claude-sonnet-4-6" },
          { "match": "Claude Sonnet 4.5", "model": "claude-sonnet-4-5" },
          { "match": "Claude Sonnet 4", "model": "claude-sonnet-4" },
          { "match": "Claude Haiku 4.5", "model": "claude-haiku-4-5" }
        ]
      }
    },
    {
      "id": "anthropic-fast-mode",
      "name": "Claude Code fast mode markdown",
      "url": "https://code.claude.com/docs/en/fast-mode.md",
      "kind": "markdown-table",
      "output": "reference",
      "table_heading": "Understand the cost tradeoff"
    },
    {
      "id": "openai-pricing",
      "name": "OpenAI API pricing",
      "url": "https://openai.com/api/pricing/",
      "kind": "html-table",
      "output": "reference"
    },
    {
      "id": "gemini-pricing",
      "name": "Gemini API pricing",
      "url": "https://ai.google.dev/gemini-api/docs/pricing",
      "kind": "html-table",
      "output": "reference"
    },
    {
      "id": "cursor-pricing",
      "name": "Cursor pricing",
      "url": "https://cursor.com/docs/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "global",
        "defaults": {
          "web_search": 0.01
        },
        "rows": [
          {
            "match": "Auto Cost",
            "model": "cursor-auto",
            "set": { "input": 0.00000125, "cache_write": 0.00000125, "cache_read": 0.00000025, "output": 0.000006 },
            "note": "Cursor moved its first-party rates out of the \"Model pricing\" table into client-side pricing widgets, so the Markdown export carries the prose but none of the numbers. Auto Cost is $1.25/MTok input and cache write, $0.25/MTok cache read, and $6/MTok output; verified 2026-08-03."
          }
        ]
      }
    },
    {
      "id": "cursor-model-pricing",
      "name": "Cursor models and pricing",
      "url": "https://cursor.com/docs/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "tool",
        "tool": "cursor",
        "defaults": {
          "web_search": 0.01
        },
        "note": "Cursor moved its first-party rates out of the \"Model pricing\" table into client-side pricing widgets, so the Markdown export carries the prose but none of the numbers. These rates are pinned here and were verified 2026-08-03.",
        "rows": [
          {
            "model": "composer-1",
            "retired": true,
            "set": { "input": 0.00000125, "cache_read": 0.000000125, "output": 0.00001 },
            "note": "Composer 1 is retired from Cursor's docs; its published rates ($1.25/$10 per 1M, cache read $0.125) are pinned here so archived Composer 1 calls still price."
          },
          {
            "model": "composer-1.5",
            "retired": true,
            "set": { "input": 0.0000035, "cache_read": 0.00000035, "output": 0.0000175 },
            "note": "Composer 1.5 is retired from Cursor's docs; its published rates ($3.50/$17.50 per 1M, cache read $0.35) are pinned here."
          },
          {
            "model": "composer-2",
            "retired": true,
            "set": { "input": 0.0000005, "cache_read": 0.0000002, "output": 0.0000025 },
            "note": "Composer 2 is retired from Cursor's docs; its published rates matched Composer 2.5 ($0.50/$2.50 per 1M, cache read $0.20) and are pinned here."
          },
          {
            "match": "Composer 2.5",
            "model": "composer-2.5",
            "set": { "input": 0.0000005, "cache_read": 0.0000002, "output": 0.0000025 }
          },
          {
            "match": "Composer 2.5",
            "model": "composer-2.5-fast",
            "set": { "input": 0.000003, "cache_write": 0.000003, "cache_read": 0.0000005, "output": 0.000015 },
            "note": "Composer 2.5 Fast ($3/MTok input, $0.50/MTok cache read, $15/MTok output) is kept as a distinct tool-scoped row; verified 2026-08-03."
          },
          {
            "match": "Grok 4.5",
            "model": "grok-4.5",
            "set": { "input": 0.000002, "cache_read": 0.0000005, "output": 0.000006 }
          },
          {
            "match": "Grok 4.5",
            "model": "grok-4.5-fast",
            "set": { "input": 0.000004, "cache_write": 0.000004, "cache_read": 0.000001, "output": 0.000018 },
            "note": "Grok 4.5 Fast ($4/MTok input, $1/MTok cache read, $18/MTok output) is kept as a distinct tool-scoped row; verified 2026-08-03."
          }
        ]
      }
    },
    {
      "id": "github-copilot-pricing",
      "name": "GitHub Copilot models and pricing",
      "url": "https://docs.github.com/en/copilot/reference/copilot-billing/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "effective_from": "2026-06-01",
      "extract": {
        "mode": "model-rows",
        "scope": "tool",
        "tool": "copilot",
        "columns": {
          "model": "Model",
          "input": "Input",
          "cache_read": "Cached input",
          "cache_write": "Cache write",
          "output": "Output"
        },
        "rows": [
          { "match": "GPT-4.1", "model": "gpt-4.1" },
          { "match": "GPT-5 mini", "model": "gpt-5-mini" },
          { "match": "GPT-5.2", "model": "gpt-5.2" },
          { "match": "GPT-5.2-Codex", "model": "gpt-5.2-codex" },
          { "match": "GPT-5.3-Codex", "model": "gpt-5.3-codex" },
          { "match": "GPT-5.4", "model": "gpt-5.4" },
          { "match": "GPT-5.4 mini", "model": "gpt-5.4-mini" },
          { "match": "GPT-5.4 nano", "model": "gpt-5.4-nano" },
          { "match": "GPT-5.5", "model": "gpt-5.5" },
          { "match": "GPT-5.6 Luna", "model": "gpt-5.6-luna" },
          { "match": "GPT-5.6 Sol", "model": "gpt-5.6-sol" },
          { "match": "GPT-5.6 Terra", "model": "gpt-5.6-terra" },
          { "match": "Claude Haiku 4.5", "model": "claude-haiku-4-5" },
          { "match": "Claude Sonnet 4", "model": "claude-sonnet-4" },
          { "match": "Claude Sonnet 4.5", "model": "claude-sonnet-4-5" },
          { "match": "Claude Sonnet 4.6", "model": "claude-sonnet-4-6" },
          { "match": "Claude Opus 4.5", "model": "claude-opus-4-5" },
          { "match": "Claude Opus 4.6", "model": "claude-opus-4-6" },
          { "match": "Claude Opus 4.7", "model": "claude-opus-4-7" },
          { "match": "Claude Opus 4.8", "model": "claude-opus-4-8" },
          {
            "match": "Claude Opus 4.8 (fast mode)",
            "model": "claude-opus-4-8-fast",
            "note": "Copilot lists fast mode as its own billable model row."
          },
          { "match": "Claude Opus 5", "model": "claude-opus-5" },
          { "match": "Claude Sonnet 5", "model": "claude-sonnet-5" },
          { "match": "Claude Fable 5", "model": "claude-fable-5" },
          { "match": "Gemini 2.5 Pro", "model": "gemini-2.5-pro" },
          { "match": "Gemini 3 Flash", "model": "gemini-3-flash" },
          { "match": "Gemini 3.1 Pro", "model": "gemini-3.1-pro" },
          { "match": "Gemini 3.5 Flash", "model": "gemini-3.5-flash" },
          { "match": "Grok Code Fast 1", "model": "grok-code-fast-1" },
          { "match": "MAI-Code-1-Flash", "model": "mai-code-1-flash" },
          { "match": "Kimi K2.7 Code", "model": "kimi-k2.7-code" },
          { "match": "Raptor mini", "model": "raptor-mini" },
          { "match": "Goldeneye", "model": "goldeneye" }
        ]
      }
    }
  ]
}
