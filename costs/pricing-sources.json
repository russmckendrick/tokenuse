          },
          {
            "model": "composer-2",
            "retired": true,
            "set": { "input": 0.0000005, "cache_read": 0.0000002, "output": 0.0000025 },
            "note": "Retired Composer 2 rates are preserved for archived calls."
          }
        ]
      }
    },
    {
      "id": "cursor-third-party-pricing",
      "name": "Cursor third-party model pricing",
      "url": "https://cursor.com/docs/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
