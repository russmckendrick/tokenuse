{
  "_metadata": {
    "schema": "tokenuse pricing-sources.v1",
    "description": "Config-driven pricing refresh sources. Rust owns generic fetch/extract/merge logic; URLs, filters, field mappings, and published book locations live here."
  },
  "published_books": {
    "upstream_url": "https://raw.githubusercontent.com/russmckendrick/tokenuse/refs/heads/main/costs/pricing-upstream.json",
    "overrides_url": "https://raw.githubusercontent.com/russmckendrick/tokenuse/refs/heads/main/costs/pricing-overrides.json"
  },
  "aliases": {
    "gpt-5.6": "gpt-5.6-sol-history",
    "gpt-5.6-sol": "gpt-5.6-sol-history"
  },
  "tool_aliases": {
    "cursor": {
      "gpt-5.6-sol": "gpt-5.6-sol-history",
      "gpt-5.6-sol-fast": "gpt-5.6-sol-fast-history",
      "gpt-5.6-sol-fast-long": "gpt-5.6-sol-fast-long-history",
      "gpt-5.6-sol-long": "gpt-5.6-sol-long-history"
    }
  },
  "sources": [
    {
      "id": "litellm",
      "name": "LiteLLM model prices",
      "url": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
      "kind": "json-map",
      "output": "upstream",
      "include": {
        "accepted_modes": [
          "chat",
          "responses"
        ],
        "key_contains": [
          "claude-opus-",
          "claude-sonnet-",
          "claude-haiku-",
          "claude-fable-",
          "claude-mythos-",
          "claude-3-",
          "gpt-5",
          "gpt-6",
          "gpt-4o",
          "o1",
          "o3",
          "gemini-",
          "grok-"
        ],
        "canonical_exact": [
          "codex-mini-latest"
        ]
      },
      "fields": {
        "input": "input_cost_per_token",
        "output": "output_cost_per_token",
        "cache_write": "cache_creation_input_token_cost",
        "cache_read": "cache_read_input_token_cost"
      },
      "defaults": {
        "web_search": 0.01
      }
    },
    {
      "id": "anthropic-pricing",
      "name": "Claude pricing markdown",
      "url": "https://platform.claude.com/docs/en/about-claude/pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "table_heading": "Model pricing",
      "extract": {
        "mode": "model-rows",
        "scope": "global",
        "columns": {
          "model": "Model",
          "input": "Base Input Tokens",
          "cache_write": "5m Cache Writes",
          "cache_read": "Cache hits and refreshes",
          "output": "Output Tokens"
        },
        "required_fields": ["input", "cache_write", "cache_read", "output"],
        "defaults": {
          "web_search": 0.01
        },
        "rows": [
          {
            "match": "Claude Fable 5.1",
            "model": "claude-fable-5-1",
            "note": "Fable 5.1 keeps Fable 5 input, cache-write, and output rates but reduces prompt-cache reads to $0.25/MTok."
          },
          {
            "match": "Claude Mythos 5.1",
            "model": "claude-mythos-5-1",
            "note": "Mythos 5.1 keeps Mythos 5 input, cache-write, and output rates but reduces prompt-cache reads to $0.25/MTok."
          },
          { "match": "Claude Fable 5", "model": "claude-fable-5" },
          { "match": "Claude Mythos 5", "model": "claude-mythos-5" },
          {
            "match": "Claude Opus 5",
            "model": "claude-opus-5",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 5 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.8",
            "model": "claude-opus-4-8",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.8 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.8",
            "model": "claude-opus-4.8",
            "set": { "fast_multiplier": 2 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which lists Opus 4.8 fast mode at $10 input and $50 output per MTok (2x base)."
          },
          {
            "match": "Claude Opus 4.7",
            "model": "claude-opus-4-7",
            "set": { "fast_multiplier": 6 },
            "note": "Fast multiplier is configured from Claude Code fast mode, which listed Opus 4.7 fast mode at $30 input and $150 output per MTok; deprecated 2026-06-25 and removed 2026-07-24. Kept so archived fast-mode calls from before removal still price correctly."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4-6",
            "set": { "fast_multiplier": 6 },
            "note": "The 6x multiplier is retained for historical Claude Code fast-speed calls; current fast mode supports only Opus 5 and Opus 4.8."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4-6-20260205",
            "set": { "fast_multiplier": 6 },
            "note": "The 6x multiplier is retained for historical Claude Code fast-speed calls; current fast mode supports only Opus 5 and Opus 4.8."
          },
          {
            "match": "Claude Opus 4.6",
            "model": "claude-opus-4.6",
            "set": { "fast_multiplier": 6 },
            "note": "The 6x multiplier is retained for historical Claude Code fast-speed calls; current fast mode supports only Opus 5 and Opus 4.8."
          },
          {
            "match": "Claude Sonnet 5",
            "model": "claude-sonnet-5",
            "note": "Anthropic made Sonnet 5 launch pricing permanent: $2 input, $2.50 5-minute cache writes, $0.20 cache reads, and $10 output per MTok."
          },
          { "match": "Claude Sonnet 4.6", "model": "claude-sonnet-4-6" },
          { "match": "Claude Sonnet 4.5", "model": "claude-sonnet-4-5" },
          { "match": "Claude Sonnet 4", "model": "claude-sonnet-4" },
          { "match": "Claude Haiku 4.5", "model": "claude-haiku-4-5" },
          {
            "match": "Claude Haiku 3.5",
            "model": "claude-haiku-3-5",
            "effective_from": "2024-12-03",
            "note": "Anthropic's historical Haiku 3.5 row corrects incomplete and higher LiteLLM rates for archived Claude Code usage."
          }
        ]
      }
    },
    {
      "id": "anthropic-fast-mode",
      "name": "Claude Code fast mode markdown",
      "url": "https://code.claude.com/docs/en/fast-mode.md",
      "kind": "markdown-table",
      "output": "reference",
      "table_heading": "Understand the cost tradeoff"
    },
    {
      "id": "openai-gpt-5-4-pricing",
      "name": "OpenAI GPT-5.4 model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-5.4.md",
      "kind": "markdown-table",
      "output": "overrides",
      "table_heading": "Text tokens",
      "extract": {
        "mode": "label-rows",
        "scope": "global",
        "model": "gpt-5.4",
        "columns": { "label": "Metric", "price": "Price" },
        "labels": {
          "input": "Input",
          "cache_read": "Cached input",
          "output": "Output"
        },
        "defaults": { "web_search": 0.01 },
        "note": "Default-tier GPT-5.4 rates. Requests above 272K input tokens use OpenAI's long-context rates, which tokenuse does not yet select per call."
      }
    },
    {
      "id": "openai-gpt-6-astra-pricing",
      "name": "OpenAI GPT-6 Astra model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-6-astra.md",
      "kind": "markdown-table",
      "output": "overrides",
      "effective_from": "2026-09-03",
      "table_heading": "Text tokens",
      "extract": {
        "mode": "label-rows",
        "scope": "global",
        "model": "gpt-6-astra",
        "columns": { "label": "Metric", "price": "Price" },
        "labels": {
          "input": "Input",
          "cache_write": "Cache writes",
          "cache_read": "Cached input",
          "output": "Output"
        },
        "defaults": { "web_search": 0.01 },
        "note": "Default-tier GPT-6 Astra rates. Requests above 272K input tokens use OpenAI's long-context rates, which tokenuse does not yet select per call."
      }
    },
    {
      "id": "openai-gpt-5-6-sol-pricing",
      "name": "OpenAI GPT-5.6 Sol model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-5.6-sol.md",
      "kind": "markdown-table",
      "output": "overrides",
      "effective_from": "2026-08-21",
      "table_heading": "Text tokens",
      "extract": {
        "mode": "label-rows",
        "scope": "global",
        "model": "gpt-5.6-sol",
        "columns": { "label": "Metric", "price": "Price" },
        "labels": {
          "input": "Input",
          "cache_read": "Cached input",
          "output": "Output"
        },
        "set": { "cache_write": 0.000005 },
        "defaults": { "web_search": 0.01 },
        "note": "Promotional Sol rates available at least through November 21, 2026; cache writes are 1.25x input. Long-context rates are not yet selected per call."
      }
    },
    {
      "id": "openai-gpt-5-6-sol-historical-pricing",
      "name": "OpenAI GPT-5.6 Sol model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-5.6-sol.md",
      "kind": "text",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "global",
        "rows": [
          {
            "match": "GPT-5.6 Sol",
            "model": "gpt-5.6-sol-history",
            "effective_to": "2026-08-21",
            "set": { "input": 0.000005, "cache_write": 0.00000625, "cache_read": 0.0000005, "output": 0.00003 },
            "note": "Pre-promotion GPT-5.6 Sol rates retained for calls before August 21, 2026. The synthetic -history lookup target lets the current live row remain the family-prefix fallback after this window expires."
          }
        ]
      }
    },
    {
      "id": "openai-gpt-5-6-terra-pricing",
      "name": "OpenAI GPT-5.6 Terra model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-5.6-terra.md",
      "kind": "markdown-table",
      "output": "overrides",
      "table_heading": "Text tokens",
      "extract": {
        "mode": "label-rows",
        "scope": "global",
        "model": "gpt-5.6-terra",
        "columns": { "label": "Metric", "price": "Price" },
        "labels": {
          "input": "Input",
          "cache_read": "Cached input",
          "output": "Output"
        },
        "set": { "cache_write": 0.0000025 },
        "defaults": { "web_search": 0.01 },
        "note": "Default-tier Terra rates; cache writes are 1.25x input. Long-context rates are not yet selected per call."
      }
    },
    {
      "id": "openai-gpt-5-6-luna-pricing",
      "name": "OpenAI GPT-5.6 Luna model pricing",
      "url": "https://developers.openai.com/api/docs/models/gpt-5.6-luna.md",
      "kind": "markdown-table",
      "output": "overrides",
      "table_heading": "Text tokens",
      "extract": {
        "mode": "label-rows",
        "scope": "global",
        "model": "gpt-5.6-luna",
        "columns": { "label": "Metric", "price": "Price" },
        "labels": {
          "input": "Input",
          "cache_read": "Cached input",
          "output": "Output"
        },
        "set": { "cache_write": 0.00000025 },
        "defaults": { "web_search": 0.01 },
        "note": "Default-tier Luna rates; cache writes are 1.25x input. Long-context rates are not yet selected per call."
      }
    },
    {
      "id": "gemini-pricing",
      "name": "Gemini API pricing",
      "url": "https://ai.google.dev/gemini-api/docs/pricing",
      "kind": "html-table",
      "output": "reference"
    },
    {
      "id": "gemini-1-5-flash-historical-pricing",
      "name": "Google Gemini 1.5 Flash price update",
      "url": "https://developers.googleblog.com/en/gemini-15-flash-updates-google-ai-studio-gemini-api/",
      "kind": "text",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "global",
        "defaults": { "web_search": 0.01 },
        "rows": [
          {
            "match": "Gemini 1.5 Flash",
            "model": "gemini-1.5-flash",
            "effective_from": "2024-08-12",
            "set": { "input": 0.000000075, "cache_read": 0.00000001875, "output": 0.0000003 },
            "note": "Historical short-context rates after Google's August 12, 2024 reduction. Requests above 128K input tokens cost 2x; Gemini 1.5 Flash was retired September 29, 2025."
          }
        ]
      }
    },
    {
      "id": "cursor-pricing",
      "name": "Cursor pricing",
      "url": "https://cursor.com/docs/models-and-pricing.md",
      "kind": "markdown-table",
      "output": "overrides",
      "extract": {
        "mode": "pinned",
        "scope": "global",
        "defaults": {
          "web_search": 0.01
        },
        "rows": [
          {
            "match": "Legacy Enterprise Auto",
            "model": "cursor-auto",
            "effective_to": "2026-09-07",
            "set": { "input": 0.00000125, "cache_write": 0.00000125, "cache_read": 0.00000025, "output": 0.000006 },
            "note": "Legacy Enterprise Auto was $1.25/MTok input and cache write, $0.25/MTok cache read, and $6/MTok output. Cursor says this flat rate ends September 7, 2026; newer Auto requests bill the routed model's list price."
          }
        ]
      }
    },
    {
